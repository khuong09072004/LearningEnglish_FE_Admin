<template>
  <div class="flex min-h-screen bg-gray-50/50">
    <!-- Sidebar -->
    <aside
      :class="[
        'fixed top-0 left-0 z-40 h-screen transition-all duration-300 border-r bg-white',
        sidebarCollapsed ? 'w-16' : 'w-64'
      ]"
    >
      <!-- Logo & Company -->
      <div class="flex h-16 items-center border-b px-4">
        <transition name="fade" mode="out-in">
          <div v-if="!sidebarCollapsed" key="full" class="flex items-center space-x-3">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <div>
              <h2 class="text-base font-semibold text-gray-900">Learn English</h2>
              <p class="text-xs text-gray-500">Enterprise</p>
            </div>
          </div>
          <div v-else key="collapsed" class="mx-auto">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
        </transition>
      </div>

      <!-- Search Bar -->
      <div class="p-4 border-b">
        <div class="relative">
          <a-icon type="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm" />
          <input
            v-if="!sidebarCollapsed"
            type="text"
            placeholder="Search documentation"
            class="w-full pl-9 pr-16 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-200 focus:border-transparent"
          />
          <kbd v-if="!sidebarCollapsed" class="absolute right-2 top-1/2 transform -translate-y-1/2 pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-gray-100 px-1.5 font-mono text-[10px] font-medium text-gray-600">
            <span>Ctrl</span>K
          </kbd>
          <a-icon v-else type="search" class="text-gray-400" />
        </div>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 overflow-y-auto py-4">
        <!-- General -->
        <div v-if="!sidebarCollapsed" class="px-3 mb-2">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider px-3">General</p>
        </div>
        <div class="space-y-1 px-3">
          <nuxt-link
            v-for="item in generalMenuItems"
            :key="item.path"
